{
  "$id": "https://mindnote.local/schemas/v1/encryption.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "vaultId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "cipher": {
      "type": "string",
      "const": "AES-256-GCM"
    },
    "objectIds": {
      "type": "string",
      "const": "HMAC-SHA256"
    },
    "keys": {
      "minItems": 1,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "password",
              "recovery"
            ]
          },
          "kdf": {
            "type": "string",
            "const": "PBKDF2-SHA256"
          },
          "iterations": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 10000000
          },
          "salt": {
            "type": "string",
            "minLength": 24,
            "maxLength": 24,
            "pattern": "^[A-Za-z0-9+/]{22}==$"
          },
          "iv": {
            "type": "string",
            "minLength": 16,
            "maxLength": 16,
            "pattern": "^[A-Za-z0-9+/]{16}$"
          },
          "wrappedKey": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9+/]{64}$"
          }
        },
        "required": [
          "kind",
          "kdf",
          "iterations",
          "salt",
          "iv",
          "wrappedKey"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "schemaVersion",
    "vaultId",
    "cipher",
    "objectIds",
    "keys",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}

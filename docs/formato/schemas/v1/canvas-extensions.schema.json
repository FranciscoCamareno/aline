{
  "$id": "https://mindnote.local/schemas/v1/canvas-extensions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "documentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "elementLinks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "elementId": {
            "type": [
              "string",
              "null"
            ]
          },
          "fragment": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "documentId",
          "elementId"
        ],
        "additionalProperties": false
      }
    },
    "mindMap": {
      "type": "object",
      "properties": {
        "parentByNode": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "collapsedNodeIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hidden": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "locked": {
                "type": "boolean"
              }
            },
            "required": [
              "opacity",
              "locked"
            ],
            "additionalProperties": false
          }
        },
        "badges": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "parentByNode",
        "collapsedNodeIds"
      ],
      "additionalProperties": false
    },
    "noteEmbeds": {
      "type": "array",
      "items": {}
    },
    "danglingConnectorIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schemaVersion",
    "documentId",
    "elementLinks",
    "mindMap",
    "noteEmbeds",
    "danglingConnectorIds"
  ],
  "additionalProperties": false
}

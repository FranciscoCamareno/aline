{
  "name": "mindnote",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema personal de mapas mentales y notas conectadas (núcleo local)",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "assets": "node scripts/copy-excalidraw-assets.mjs && node scripts/copy-fonts.ts && node scripts/third-party-notices.ts",
    "dev": "pnpm assets && vite",
    "build": "pnpm assets && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium",
    "verify": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "spike:fase0": "pnpm assets && vite build -c vite.spike.config.ts && vite preview -c vite.spike.config.ts",
    "test:fase0": "playwright test -c playwright.fase0.config.ts",
    "licenses": "node scripts/licenses.ts",
    "licenses:check": "node scripts/licenses.ts --check",
    "schemas": "node scripts/export-schemas.ts",
    "test:e2e:all": "playwright test",
    "test:rendimiento": "playwright test tests/e2e/rendimiento.spec.ts --project=chromium --workers=1"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/architects-daughter": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/libre-baskerville": "5.3.0",

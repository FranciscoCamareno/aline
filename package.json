{
  "name": "mindnote",
  "private": true,
  "version": "0.1.0",
  "description": "Sistema personal de mapas mentales y notas conectadas (núcleo local)",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "assets": "node scripts/copy-excalidraw-assets.mjs && node scripts/third-party-notices.ts",
    "dev": "pnpm assets && vite",
    "build": "pnpm assets && tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "spike:fase0": "pnpm assets && vite build -c vite.spike.config.ts && vite preview -c vite.spike.config.ts",
    "test:fase0": "playwright test -c playwright.fase0.config.ts",
    "licenses": "node scripts/licenses.ts",
    "licenses:check": "node scripts/licenses.ts --check",
    "schemas": "node scripts/export-schemas.ts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@excalidraw/excalidraw": "0.18.1",
    "codemirror": "6.0.2",
    "dexie": "4.4.6",
    "fake-indexeddb": "6.2.5",
    "i18next": "26.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.16",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zod": "4.6.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "license": "MIT",
  "author": "F. C.",
  "repository": {
    "type": "git",
    "url": "https://github.com/FranciscoCamareno/aline.git"
  }
}

# Variables públicas (se incrustan en la compilación). NUNCA poner secretos aquí.
# `.env` (versionado) ya trae el ID de cliente OAuth del proyecto. Para usar otro proyecto de
# Google Cloud (p. ej. una copia autoalojada), copia este archivo a .env.local y ajústalo.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_PICKER_API_KEY=
VITE_APP_BASE_URL=http://localhost:5173
